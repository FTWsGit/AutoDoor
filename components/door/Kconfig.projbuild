menu "AutoDoor: Door"

    config AUTODOOR_SERVO_GPIO
        int "Servo PWM GPIO"
        range 0 21
        default 1

    config AUTODOOR_DOOR_CLOSED_DEG
        int "Servo angle for the closed position (degrees)"
        range 0 180
        default 0

    config AUTODOOR_DOOR_OPEN_DEG
        int "Servo angle for the open position (degrees)"
        range 0 180
        default 120

    config AUTODOOR_DOOR_OPEN_HOLD_MS
        int "How long the door stays open (ms)"
        range 100 60000
        default 3000

endmenu
